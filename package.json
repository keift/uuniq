{
  "name": "uuniq",
  "version": "1.3.26",
  "description": "Short yet unique IDs.",
  "license": "MIT",
  "homepage": "https://github.com/keift/uuniq",
  "bugs": "https://github.com/keift/uuniq/issues",
  "scripts": {
    "tests": "bun run lint && bun test",
    "retouch": "bun run prettier",
    "build": "tsdown",
    "lint": "eslint ./",
    "prettier": "prettier --write ./"
  },
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.mts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "types": "./dist/types.d.mts"
    }
  },
  "dependencies": {
    "@types/any-base": "^1.1.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.throttle": "^4.1.9",
    "any-base": "^1.1.0",
    "lodash.merge": "^4.6.2",
    "lodash.throttle": "^4.1.1"
  },
  "devDependencies": {
    "@keyv/mongo": "latest",
    "keyv": "latest",
    "prettier": "latest",
    "rulint": "latest",
    "tsdown": "latest",
    "unrun": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keift/uuniq"
  },
  "keywords": [
    "id",
    "unique",
    "unique-id",
    "snowflake",
    "snowflake-id",
    "increment",
    "increment-id",
    "symbolic",
    "symbolic-id"
  ]
}
